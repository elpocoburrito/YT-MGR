# YouTube Data API v3 OAuth 2.0 credentials
# Get these from https://console.cloud.google.com/apis/credentials
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# ---------------------------------------------------------------------------
# Throttling / retry settings (optional)
# ---------------------------------------------------------------------------

# Minimum seconds between API requests (default 0.25 = ~4 requests/sec).
# Increase (e.g. 1.0) if you keep hitting 403 rate-limit errors.
# YTMGR_MIN_INTERVAL=0.25

# Maximum retry attempts for transient errors (default 5).
# YTMGR_MAX_RETRIES=5

# Exponential backoff base (seconds) and cap (seconds).
# YTMGR_BACKOFF_BASE=1.0
# YTMGR_BACKOFF_MAX=60.0

# ---------------------------------------------------------------------------
# Quota accounting (optional)
# ---------------------------------------------------------------------------

# Daily quota for your project (default 10000 units).
# YTMGR_DAILY_QUOTA=10000

# Warn when this fraction of the quota is used (default 0.8 = 80%).
# YTMGR_QUOTA_WARN_RATIO=0.8

# Refuse requests that would exceed the daily budget (default on).
# Set to 0 to disable the local guard.
# YTMGR_QUOTA_ENFORCE=1

# ---------------------------------------------------------------------------
# Batching (optional) — drastically reduces HTTP requests for bulk inserts
# ---------------------------------------------------------------------------

# Sub-requests per batch (1-50; default 50).
# YTMGR_BATCH_SIZE=50

# Use batched inserts for bulk operations (default on). 0 disables batching.
# YTMGR_USE_BATCH=1